{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Kind protected sample demo with an asynchronous Strands worker.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]",
      "Description": "Private deployment artifact bucket in this region."
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "kind/[A-Za-z0-9._/-]+[.]zip",
      "Description": "Immutable package object key."
    },
    "AccessCodeDigest": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "[0-9a-f]{64}",
      "Description": "SHA256 of a randomly generated coordinator access code. Never use a human password."
    },
    "SessionSigningKey": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 43,
      "MaxLength": 128,
      "AllowedPattern": "[A-Za-z0-9_-]+",
      "Description": "Independent cryptographically random session signing key."
    },
    "DailyAiLimit": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 0,
      "MaxValue": 100,
      "Description": "Maximum admitted live AI runs per UTC day. Zero disables live runs."
    }
  },
  "Resources": {
    "WorkspaceTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      }
    },
    "WorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-worker"
        },
        "RetentionInDays": 7
      }
    },
    "FailureQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KindRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkspaceTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkerLogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:InvokeModelWithResponseStream"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/amazon.nova-lite-v1:0"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "FailureQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "KindRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkspaceTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiLogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "AgentWorker",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP"
      }
    },
    "AgentWorker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-worker"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "server.lambda_entry.worker",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "MemorySize": 1024,
        "Timeout": 300,
        "Environment": {
          "Variables": {
            "KIND_HOSTED": "1",
            "KIND_TABLE_NAME": {
              "Ref": "WorkspaceTable"
            },
            "KIND_BEDROCK_MODEL_ID": "amazon.nova-lite-v1:0"
          }
        },
        "ReservedConcurrentExecutions": 1
      }
    },
    "WebFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "server.lambda_entry.handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "MemorySize": 512,
        "Timeout": 29,
        "Environment": {
          "Variables": {
            "KIND_HOSTED": "1",
            "KIND_TABLE_NAME": {
              "Ref": "WorkspaceTable"
            },
            "KIND_BEDROCK_MODEL_ID": "amazon.nova-lite-v1:0",
            "KIND_WORKER_NAME": {
              "Ref": "AgentWorker"
            },
            "KIND_ACCESS_DIGEST": {
              "Ref": "AccessCodeDigest"
            },
            "KIND_SESSION_KEY": {
              "Ref": "SessionSigningKey"
            },
            "KIND_DAILY_AI_LIMIT": {
              "Ref": "DailyAiLimit"
            },
            "KIND_PUBLIC_HOST": {
              "Fn::Sub": "${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
            }
          }
        }
      }
    },
    "WorkerDelivery": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "AgentWorker"
        },
        "Qualifier": "$LATEST",
        "MaximumRetryAttempts": 0,
        "MaximumEventAgeInSeconds": 60,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "FailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "WebFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 29000
      }
    },
    "Route": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 6,
          "ThrottlingRateLimit": 3
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "WebFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    }
  },
  "Outputs": {
    "DemoUrl": {
      "Description": "Coordinator sign in and volunteer response pages over HTTPS.",
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "WorkspaceTableName": {
      "Description": "Retained sample workspace table.",
      "Value": {
        "Ref": "WorkspaceTable"
      }
    },
    "FailedJobQueue": {
      "Description": "Retained queue of failed worker deliveries.",
      "Value": {
        "Ref": "FailureQueue"
      }
    }
  }
}
